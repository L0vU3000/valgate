// Copy this file to Secrets.xcconfig (gitignored — see AGENTS.md rule 2)
// and set a real value there. Never commit Secrets.xcconfig.
//
// xcconfig quirk: "//" ANYWHERE on a line starts a comment, including inside
// a value, so a literal "://" cannot be written directly here. Compose it
// from single-slash pieces (each safe on its own) instead, as below.
VALGATE_URL_SLASH = /
VALGATE_URL_DOUBLE_SLASH = $(VALGATE_URL_SLASH)$(VALGATE_URL_SLASH)
VALGATE_API_BASE_URL = https:$(VALGATE_URL_DOUBLE_SLASH)replace-with-real-staging-host.invalid
CLERK_PUBLISHABLE_KEY = replace-with-real-clerk-publishable-key
